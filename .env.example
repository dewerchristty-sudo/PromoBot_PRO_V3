NOTIFICATION_END_HOUR=22
ENABLE_DEV_MODE=False
MIN_NOTIFICATION_INTERVAL_SECONDS=600
MAX_NOTIFICATION_INTERVAL_SECONDS=1200

# Inteligencia de ofertas (fase 1: somente modo sombra)
OFFER_SCORE_ENABLED=False
OFFER_SHADOW_PIPELINE_ENABLED=True
OFFER_SHADOW_DB_PATH=offer_shadow.db
OFFER_DASHBOARD_REFRESH_SECONDS=10

# Ativacao controlada do Scheduler Inteligente (Sprint 6).
# Com ENABLED=False ou CANARY_PERCENT=0, o fluxo permanece 100% legado.
