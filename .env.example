# WhatsApp via Evolution API local
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=promobot
EVOLUTION_API_KEY=
WHATSAPP_PHONES=
# IDs dos grupos separados por virgula (Evolution API, formato ...@g.us)
WHATSAPP_GROUPS=
# Roteamento opcional: um grupo para cada categoria
WHATSAPP_GROUP_MAMAE_BEBE=
WHATSAPP_GROUP_CASA_ENXOVAL=
WHATSAPP_GROUP_ELETRODOMESTICOS=
WHATSAPP_GROUP_SMARTPHONES_TECNOLOGIA=
WHATSAPP_GROUP_BELEZA_PERFUMARIA=
WHATSAPP_GROUP_LIMPEZA_UTILIDADES=
# Lojas que nao devem gerar notificacoes, separadas por virgula
NOTIFICATION_DISABLED_STORES=
# Qualidade e controle de volume (use 0 para desabilitar uma regra)
MAX_OFFER_AGE_HOURS=24
MIN_DISCOUNT_PERCENT=10
MAX_NOTIFICATIONS_PER_HOUR=5
MAX_NOTIFICATIONS_PER_GROUP_PER_HOUR=5
NOTIFICATION_START_HOUR=8
NOTIFICATION_END_HOUR=22
MIN_NOTIFICATION_INTERVAL_SECONDS=120
MAX_NOTIFICATION_INTERVAL_SECONDS=300

# WhatsApp via Z-API
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

# WhatsApp via webhook/API generico
