OFFER_CANARY_MAX_ROLLBACKS_PER_HOUR=2
OFFER_CANARY_MAX_ERROR_RATE_PERCENT=10
OFFER_CANARY_MAX_DECISION_TIME_MS=500
OFFER_CANARY_STOP_ON_DUPLICATE=True
OFFER_CANARY_STOP_ON_AUDIT_FAILURE=True

